# Salin jadi .env lalu isi. Semua nilai di bawah sudah terisi bawaan,
# tinggal TELEGRAM_BOT_TOKEN dan QWEN_API_KEY yang wajib benar.

TELEGRAM_BOT_TOKEN=8823261756:AAH9xczdNpqdb_fDQXEDd4Ft_JA0an8yuYw

QWEN_API_KEY=sk-ws-H.DDDPDML.NWLk.MEUCIQDWo9EehUUeap-FEoOzyw79zh7iS75Kzat7rXjhw8bcxQIgBIE6LNMqm4efyKxVSZ57_xhmhoWUDDe1Yl6Xb53Pdrc
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODELS=qwen3.8-max,qwen3.8-flash,qwen3.7-max,qwen-plus
QWEN_FAST_MODELS=qwen3.8-flash,qwen3.7-flash,qwen-flash,qwen-plus
QWEN_VL_MODELS=qwen3.8-max,qwen3.8-flash,qwen3-vl-plus,qwen-vl-max
# Anggaran token berpikir untuk penulisan artikel utama. Isi 0 untuk mematikan (lebih cepat).
QWEN_WRITE_THINKING=3000

# Konteks merek dan suara tulisan yang dipakai penulis artikel.
BRAND_CONTEXT=
ARTICLE_VOICE=
# Jumlah maksimal gambar di dalam isi artikel (gambar utama tidak dihitung).
MAX_INLINE_IMAGES=2
FRAME_COUNT=10

# Daftar user Telegram yang boleh pakai bot, pisahkan dengan koma. Kosongkan kalau mau terbuka.
ALLOWED_USER_IDS=

# URL publik menuju bot, tanpa slash di ujung. Isi kalau mau gambar ikut terunduh saat import.
# Contoh: http://123.45.67.89:8055  atau  https://bot.piranusa.internal
PUBLIC_BASE_URL=
PUBLIC_BASE_URL_AUTO=0

MEDIA_HOST=0.0.0.0
MEDIA_PORT=8055

# Metadata WordPress untuk file hasil export.
WP_SITE_TITLE=Piranusa
WP_SITE_LINK=https://www.piranusa.com
WP_AUTHOR_LOGIN=reza
WP_AUTHOR_EMAIL=reza@contrivent.com

# Prioritas bahasa subtitle dan proxy kalau IP kena blokir YouTube.
TRANSCRIPT_LANGUAGES=id,en
YTDLP_PROXY=

# WordPress REST API (opsional). Kalau diisi, bot upload gambar + bikin draft otomatis.
# WP_APP_PASSWORD dibuat di WP > Users > Profile > Application Passwords (26 karakter).
WP_URL=
WP_USER=
WP_APP_PASSWORD=
WP_STATUS=draft
